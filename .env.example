APP_ENV=dev                 # dev | test | prod
SECRET_KEY=change-me
# MySQL 8.4 (required: no SQLite fallback). REQUIRE_MYSQL=1 refuses SQLite, MariaDB and MySQL < 8.4 at start-up;
# production (APP_ENV=prod) always requires MySQL.
DATABASE_URL=mysql+pymysql://smartrest:PASSWORD@127.0.0.1:3308/smartrest?charset=utf8mb4
REQUIRE_MYSQL=1
TEST_DATABASE_URL=mysql+pymysql://stage_test:PASSWORD@127.0.0.1:3311/smartrest_test?charset=utf8mb4
SEED_PASSWORD=choose-a-demo-password
# SEED_PASSWORD_ADMIN=another-password   # optional: own password for one account (SEED_PASSWORD_<USERNAME>)
# SMARTREST_TODAY=2026-09-27   # optional fixed "today" for tests and demos
# TRUST_PROXY=1             # only behind a reverse proxy (nginx for HTTPS): number of proxies in front
