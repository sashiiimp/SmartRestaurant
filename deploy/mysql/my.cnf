# SmartRestaurant private MySQL 8.4 instance. Read ONLY through --defaults-file (never /etc/my.cnf, which belongs to
# aaPanel's MariaDB). Local socket for the app, TCP bound to 127.0.0.1 only, X Protocol (33060) off.
[mysqld]
basedir                  = /opt/mysql-8.4.11
datadir                  = /srv/smartrest-mysql/data
socket                   = /srv/smartrest-mysql/run/mysql.sock
pid-file                 = /srv/smartrest-mysql/run/mysqld.pid
tmpdir                   = /srv/smartrest-mysql/tmp
log-error                = /srv/smartrest-mysql/log/error.log
port                     = 3308
bind-address             = 127.0.0.1
mysqlx                   = OFF
skip-name-resolve        = ON
local_infile             = OFF
character-set-server     = utf8mb4
collation-server         = utf8mb4_unicode_ci
default-time-zone        = +00:00
max_connections          = 40
performance_schema       = OFF
innodb_buffer_pool_size  = 128M
innodb_log_buffer_size   = 8M
key_buffer_size          = 8M
table_open_cache         = 400
skip-log-bin

[client]
socket                   = /srv/smartrest-mysql/run/mysql.sock
port                     = 3308
