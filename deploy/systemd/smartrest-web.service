[Unit]
Description=SmartRestaurant web app (gunicorn)
# production runs on MySQL 8.4 since the 9 Oct 2026 cutover; MariaDB (smartrest-db) stays only as the rollback source
Requires=smartrest-mysql.service
After=smartrest-mysql.service network.target

[Service]
Type=simple
User=smartrest
Group=smartrest
WorkingDirectory=/srv/smartrest
Environment=APP_ENV=prod
Environment=TRUST_PROXY=1
RuntimeDirectory=smartrest
ExecStart=/srv/smartrest/.venv/bin/python -m gunicorn -w 2 --timeout 120 -b 127.0.0.1:39500 \
  --control-socket /run/smartrest/gunicorn.ctl \
  --access-logfile instance/gunicorn-access.log --error-logfile instance/gunicorn-error.log wsgi:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/smartrest/instance /srv/smartrest/data

[Install]
WantedBy=multi-user.target
