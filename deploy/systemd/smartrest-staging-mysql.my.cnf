# SmartRestaurant STAGING MySQL 8.4 instance (isolated from production's /srv/smartrest-mysql on 3308). Read ONLY
# through --defaults-file. Same settings as production; local socket + TCP on 127.0.0.1:3311, X Protocol off.
[mysqld]
basedir                  = /opt/mysql-8.4.11
datadir                  = /srv/smartrest-staging-mysql/data
socket                   = /srv/smartrest-staging-mysql/run/mysql.sock
pid-file                 = /srv/smartrest-staging-mysql/run/mysqld.pid
tmpdir                   = /srv/smartrest-staging-mysql/tmp
log-error                = /srv/smartrest-staging-mysql/log/error.log
port                     = 3311
bind-address             = 127.0.0.1
mysqlx                   = OFF
skip-name-resolve        = ON
local_infile             = OFF
character-set-server     = utf8mb4
collation-server         = utf8mb4_unicode_ci
default-time-zone        = +00:00
max_connections          = 60
performance_schema       = OFF
innodb_buffer_pool_size  = 128M
innodb_log_buffer_size   = 8M
innodb_redo_log_capacity = 64M
key_buffer_size          = 8M
table_open_cache         = 400
skip-log-bin

[client]
socket                   = /srv/smartrest-staging-mysql/run/mysql.sock
port                     = 3311
