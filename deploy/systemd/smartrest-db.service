[Unit]
Description=SmartRestaurant private MariaDB (127.0.0.1:3307)
After=network.target

[Service]
Type=simple
User=smartrest
Group=smartrest
ExecStart=/www/server/mysql/bin/mariadbd --no-defaults --basedir=/www/server/mysql \
  --datadir=/srv/smartrest/.mariadb/data --socket=/srv/smartrest/.mariadb/mysql.sock \
  --pid-file=/srv/smartrest/.mariadb/mysql.pid --port=3307 --bind-address=127.0.0.1 \
  --innodb-buffer-pool-size=64M --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci \
  --max-connections=40
StandardOutput=append:/srv/smartrest/.mariadb/server.log
StandardError=append:/srv/smartrest/.mariadb/server.log
TimeoutStopSec=120
Restart=on-failure
LimitNOFILE=16384
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/smartrest/.mariadb

[Install]
WantedBy=multi-user.target
